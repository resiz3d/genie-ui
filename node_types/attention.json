{
  "_comment": "Attention patches — MODEL-in/MODEL-out nodes chained between the diffusion-model loader and the sampler. Each is `bypassable`, so the form offers an enable/disable toggle at the top of its section and a disabled node is removed at generate time with its `model` link reconnected (for anyone without the custom node installed). Numbers and combos enrich from /object_info. SolAttnPatch's optional `tau_profile` is a forced link input, so it stays graph-driven. Note: KJNodes documents PathchSageAttentionKJ as a global patch that isn't undone by removing the node — run it once with `disabled` to revert.",
  "nodes": {
    "PathchSageAttentionKJ": {
      "display_name": "Patch Sage Attention KJ",
      "bypassable": true,
      "recognize": {
        "variants": [
          {
            "match": [{ "when": "any" }],
            "group": "Sage Attention",
            "collapsed": true,
            "expose": {
              "sage_attention": { "name": "sage_attention",     "label": "Sage attention", "control": "combo",  "width": "2/3", "order": 60 },
              "allow_compile":  { "name": "sage_allow_compile", "label": "Allow compile",  "control": "toggle", "width": "1/3", "order": 61 }
            }
          }
        ]
      }
    },
    "ModelAttentionBackend": {
      "display_name": "Model Attention Backend",
      "bypassable": true,
      "recognize": {
        "variants": [
          {
            "match": [{ "when": "any" }],
            "group": "Attention Backend",
            "collapsed": true,
            "expose": {
              "attention": { "name": "attention_backend", "label": "Backend", "control": "combo", "width": "full", "order": 62 }
            }
          }
        ]
      }
    },
    "SolAttnPatch": {
      "display_name": "Patch Sol-Attn",
      "bypassable": true,
      "recognize": {
        "variants": [
          {
            "match": [{ "when": "any" }],
            "group": "Sol-Attn (sparse attention)",
            "collapsed": true,
            "expose": {
              "tau":               { "name": "sol_tau",               "label": "Tau (sparsity)",    "control": "number", "width": "1/4", "order": 63.01 },
              "start_percent":     { "name": "sol_start_percent",     "label": "Start %",           "control": "number", "width": "1/4", "order": 63.02 },
              "end_percent":       { "name": "sol_end_percent",       "label": "End %",             "control": "number", "width": "1/4", "order": 63.03 },
              "min_tokens":        { "name": "sol_min_tokens",        "label": "Min tokens",        "control": "number", "width": "1/4", "order": 63.04 },
              "sink_conditioning": { "name": "sol_sink_conditioning", "label": "Sink conditioning", "control": "combo",  "width": "1/2", "order": 63.05 },
              "dense_blocks":      { "name": "sol_dense_blocks",      "label": "Dense blocks",      "control": "text",   "width": "1/2", "order": 63.06 },
              "int8_qk":           { "name": "sol_int8_qk",           "label": "INT8 QK",           "control": "toggle", "width": "1/4", "order": 63.07 },
              "int8_pv":           { "name": "sol_int8_pv",           "label": "INT8 PV",           "control": "toggle", "width": "1/4", "order": 63.08 },
              "use_tma":           { "name": "sol_use_tma",           "label": "TMA kernels",       "control": "toggle", "width": "1/4", "order": 63.09 },
              "morton":            { "name": "sol_morton",            "label": "Morton reorder",    "control": "toggle", "width": "1/4", "order": 63.10 },
              "morton_curve":      { "name": "sol_morton_curve",      "label": "Morton curve",      "control": "combo",  "width": "1/2", "order": 63.11 }
            }
          }
        ]
      }
    }
  }
}
