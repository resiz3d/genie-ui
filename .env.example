# Copy this file to .env and fill in your key from https://kie.ai/api-key
KIE_API_KEY=your_api_key_here

# Optional: port for the local server (default 3000)
PORT=3000

# Optional: which network interface to listen on (default 127.0.0.1 = this PC
# only). Set HOST=0.0.0.0 to also allow other devices on your home network to
# reach the app at http://<this-pc-ip>:<PORT> (e.g. http://192.168.1.50:3000).
# WARNING: the app has no login and spends your kie.ai credits — only enable LAN
# access on a network you trust, and never expose it to the public internet.
# HOST=0.0.0.0

# Optional: require a password to use the app. Leave unset/blank for no login.
# When set, every page and API call requires signing in first (recommended if
# you enable LAN access above). Anyone with this password has full access.
# APP_PASSWORD=

# Optional: where generated results (OUTPUT_DIR) and saved reference media /
# gallery (INPUT_DIR) are stored. Defaults to the app's own "output" and "input"
# folders. Set either to an absolute path (e.g. D:\genie\output or /mnt/media/output)
# or a path relative to the app folder. Per-project subfolders are created inside.
# The legacy names VIDEO_DIR / IMAGES_DIR are still honored if set.
# OUTPUT_DIR=
# INPUT_DIR=
# EXPORTS_DIR=   # where the "Export" button writes shareable history bundles (default: exports/)

# Optional: local ComfyUI integration (see docs/COMFYUI.md). Point at a running
# ComfyUI instance to run local .json workflows from the UI. WORKFLOWS_DIR holds
# your API-format workflow exports (default: workflows/).
# COMFYUI_URL=http://127.0.0.1:8188
# WORKFLOWS_DIR=
# Where per-workflow config (chosen model/LoRA/VAE/sampler + LoRA list) is saved
# (default: settings/comfy/). Shared across devices that hit this server.
# COMFY_SETTINGS_DIR=
# Live preview frames while a local run renders: auto (fast, low-fidelity — the
# default), taesd (sharper, needs approx-VAE files in ComfyUI's models/vae_approx/),
# latent2rgb, or off to disable previews for everyone regardless of the UI setting.
# COMFY_PREVIEW_METHOD=auto
